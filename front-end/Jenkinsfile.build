pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                git branch: 'feature/DFP-47_Generar_script_jenkins_deploy',
                    url: 'https://github.com/FernandoJoachin/devops-final-project.git'
            }
        }

        stage('Build and Dockerize') {
            steps {
                dir('./front-end') {
                    bat 'npm install'
                    bat 'npm run build'
                    bat 'docker build -t frontend:latest .'
                    bat 'docker save frontend:latest -o ../frontend-image.tar' 
                }
                archiveArtifacts artifacts: 'frontend-image.tar', fingerprint: true
                archiveArtifacts artifacts: 'front-end/.env', fingerprint: true 
            }
        }
    }
}

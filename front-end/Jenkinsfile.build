pipeline {
    agent any

    environment {
        VITE_API_URL = 'http://192.168.0.13:3000/'
    }

    stages {

        stage('Clonar repositorio') {
            steps {
                git branch: 'develop',
                    url: 'https://github.com/FernandoJoachin/devops-final-project.git'
            }
        }

        stage('Build y Dockerizar frontend') {
            steps {
                dir('front-end') {
                    writeFile file: '.env', text: "VITE_API_URL=${VITE_API_URL}"

                    bat 'npm install'
                    bat 'npm run build'

                    bat 'docker rmi -f frontend2:latest || exit 0'

                    bat 'docker build -t frontend2:latest .'

                    bat 'docker save frontend2:latest -o ..\\frontend2-image.tar'
                }

                archiveArtifacts artifacts: 'frontend2-image.tar', fingerprint: true
                archiveArtifacts artifacts: 'front-end/.env', fingerprint: true
            }
        }
    }
}

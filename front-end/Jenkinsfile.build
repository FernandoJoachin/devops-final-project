// frontend-build
pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                git branch: 'develop',
                    url: 'https://github.com/FernandoJoachin/devops-final-project.git'
            }
        }

        stage('Build') {
          steps {
                dir('./front-end') {
                    bat 'npm install'
                    bat 'npm run build'
                    archiveArtifacts artifacts: 'dist/**', fingerprint: true
                }
            }
        }
    }
}

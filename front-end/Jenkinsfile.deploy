pipeline {
    agent any

    environment {
        DESTINATION = "ubuntu@192.168.0.15"
        DESTINATION_ROUTE = "/var/www/html"
    }

    stages {
        stage('Get frontend build') {
            steps {
                echo "Copying artifacts"
                copyArtifacts(projectName: 'Front Build', selector: lastSuccessful())
            }
        }

        stage('Enviar a la VM') {
            steps {
                withCredentials([sshUserPrivateKey(credentialsId: 'ssh-key', keyFileVariable: 'SSH_KEY')]) {
                    bat '''
                        echo Enviando archivos a la VM...
                        powershell -Command "chmod 600 $env:SSH_KEY"
                        powershell -Command "scp -o StrictHostKeyChecking=no -i $env:SSH_KEY -r dist/* $env:DESTINATION:`$env:DESTINATION_ROUTE`"
                    '''
                }
            }
        }

        stage('Restart Nginx') {
            steps {
                withCredentials([sshUserPrivateKey(credentialsId: 'ssh-key', keyFileVariable: 'SSH_KEY')]) {
                    bat '''
                        echo Reiniciando NGINX en la VM...
                        powershell -Command "ssh -o StrictHostKeyChecking=no -i $env:SSH_KEY $env:DESTINATION 'sudo systemctl restart nginx'"
                    '''
                }
            }
        }
    }

    post {
        failure {
            echo 'Pipeline failed.'
        }
        success {
            echo 'Pipeline successful.'
        }
    }
}

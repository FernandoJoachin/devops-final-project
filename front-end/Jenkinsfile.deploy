pipeline {
    agent any

    environment {
        DESTINATION = "ubuntu-server@192.168.0.14"
        REMOTE_IMAGE_PATH = "/home/ubuntu-server/frontend-image.tar"
        REMOTE_ENV_PATH = "/home/ubuntu-server/.env"
        IMAGE_NAME = "frontend:latest"
        CONTAINER_NAME = "frontend"
        PORT_MAPPING = "8080:80"
    }

    stages {
        stage('Get frontend Docker image and .env') {
            steps {
                echo "Copying Docker image and .env artifact"
                copyArtifacts(projectName: 'Front Build', selector: lastSuccessful())
                bat 'dir *.tar'
                bat 'dir front-end'
            }
        }

        stage('Deploy Docker container on VM') {
            steps {
                withCredentials([sshUserPrivateKey(credentialsId: 'ssh-key', keyFileVariable: 'SSH_KEY')]) {
                    bat """
                        echo Sending Docker image to VM...
                        scp -o StrictHostKeyChecking=no -i "%SSH_KEY%" frontend-image.tar %DESTINATION%:%REMOTE_IMAGE_PATH%

                        echo Sending .env to VM...
                        scp -o StrictHostKeyChecking=no -i "%SSH_KEY%" front-end/.env %DESTINATION%:%REMOTE_ENV_PATH%

                        echo Deploying container on VM...
                        ssh -o StrictHostKeyChecking=no -i "%SSH_KEY%" %DESTINATION% "
                            docker rmi -f %IMAGE_NAME% || true &&
                            docker load -i %REMOTE_IMAGE_PATH% &&
                            docker stop %CONTAINER_NAME% || true &&
                            docker rm %CONTAINER_NAME% || true &&
                            docker run --env-file %REMOTE_ENV_PATH% -d --name %CONTAINER_NAME% -p %PORT_MAPPING% %IMAGE_NAME%
                        "
                    """
                }
            }
        }
    }

    post {
        failure {
            echo 'Pipeline failed.'
        }
        success {
            echo 'Pipeline successful.'
        }
    }
}

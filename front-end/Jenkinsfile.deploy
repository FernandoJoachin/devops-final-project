pipeline {
    agent any

    environment {
        DESTINATION = "ubuntu-server@192.168.0.15"
        TEMP_ROUTE = "/home/ubuntu-server/temp_frontend"
        FINAL_ROUTE = "/var/www/html"
    }

    stages {
        stage('Get frontend build') {
            steps {
                echo "Copying artifacts"
                copyArtifacts(projectName: 'Front Build', selector: lastSuccessful())
                bat 'dir dist /s'
            }
        }

        stage('Send to temporary directory in VM') {
            steps {
                withCredentials([sshUserPrivateKey(credentialsId: 'ssh-key', keyFileVariable: 'SSH_KEY')]) {
                    bat '''
                        echo Creating temporary directory if it doesn't exists...
                        ssh -o StrictHostKeyChecking=no -i "%SSH_KEY%" %DESTINATION% "mkdir -p %TEMP_ROUTE%"

                        echo Sending VM (temporary)...
                        scp -o StrictHostKeyChecking=no -i "%SSH_KEY%" -r dist/* %DESTINATION%:%TEMP_ROUTE%/
                    '''
                }
            }
        }

        stage('Clear and move to /var/www/html') {
            steps {
                withCredentials([sshUserPrivateKey(credentialsId: 'ssh-key', keyFileVariable: 'SSH_KEY')]) {
                    bat '''
                        echo Cleaning and moving...
                        ssh -o StrictHostKeyChecking=no -i "%SSH_KEY%" %DESTINATION% ^
                            'sudo rm -rf %FINAL_ROUTE%/dist && sudo mv %TEMP_ROUTE%/* %FINAL_ROUTE%/'
                    '''
                }
            }
        }


        stage('Restart Nginx') {
            steps {
                withCredentials([sshUserPrivateKey(credentialsId: 'ssh-key', keyFileVariable: 'SSH_KEY')]) {
                    bat '''
                        echo Reiniciando NGINX...
                        ssh -o StrictHostKeyChecking=no -i "%SSH_KEY%" %DESTINATION% "sudo systemctl restart nginx"
                    '''
                }
            }
        }
    }

    post {
        failure {
            echo 'Pipeline failed.'
        }
        success {
            echo 'Pipeline successful.'
        }
    }
}

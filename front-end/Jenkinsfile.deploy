pipeline {
    agent any

    environment {
        DESTINATION = "ubuntu@192.168.0.15"
        DESTINATION_ROUTE = "/var/www/html"
    }

    stages {
        stage('Get frontend build') {
            steps {
                echo "Copying artifacts"
                copyArtifacts(projectName: 'Front Build', selector: lastSuccessful())
            }
        }

        stage('Enviar a la VM') {
            steps {
                withCredentials([sshUserPrivateKey(credentialsId: 'ssh-key', keyFileVariable: 'ssh-key')]) {
                    sh '''
                        echo "Sending to VM..."
                        chmod 600 $SSH_KEY
                        scp -o StrictHostKeyChecking=no -i $SSH_KEY -r dist/* $DESTINATION:$DESTINATION_ROUTE
                    '''
                }
            }
        }

        stage('Restart Nginx') {
            steps {
                withCredentials([sshUserPrivateKey(credentialsId: 'ssh-key', keyFileVariable: 'ssh-key')]) {
                    sh '''
                        echo "Restarting NGINX..."
                        ssh -o StrictHostKeyChecking=no -i $SSH_KEY $DESTINATION "sudo systemctl restart nginx"
                    '''
                }
            }
        }
    }

    post {
        failure {
            echo 'Pipeline failed.'
        }
        success {
            echo 'Pipeline succesful.'
        }
    }
}

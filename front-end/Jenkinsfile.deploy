pipeline {
    agent any

    environment {
        DESTINATION = "ubuntu-server@192.168.202.114"
        TEMP_ROUTE = "/home/ubuntu-server/temp_frontend"
        FINAL_ROUTE = "/var/www/html"
    }

    stages {
        stage('Get frontend build') {
            steps {
                echo "Copying build artifacts..."
                copyArtifacts(projectName: 'Front Build', selector: lastSuccessful())
                bat 'dir dist /s'
            }
        }

        stage('Send to temporary directory in VM') {
            steps {
                withCredentials([sshUserPrivateKey(credentialsId: 'ssh-key', keyFileVariable: 'SSH_KEY')]) {
                    bat '''
                        echo Creating temporary directory if it doesn't exist...
                        ssh -o StrictHostKeyChecking=no -i "%SSH_KEY%" %DESTINATION% "mkdir -p %TEMP_ROUTE%"

                        echo Sending build files to VM...
                        scp -o StrictHostKeyChecking=no -i "%SSH_KEY%" -r dist/* %DESTINATION%:%TEMP_ROUTE%/
                    '''
                }
            }
        }

        stage('Clear and move to /var/www/html') {
            steps {
                withCredentials([sshUserPrivateKey(credentialsId: 'ssh-key', keyFileVariable: 'SSH_KEY')]) {
                    bat '''
                        echo Replacing frontend in /var/www/html...
                        ssh -o StrictHostKeyChecking=no -i "%SSH_KEY%" %DESTINATION% "sudo rm -rf %FINAL_ROUTE%/* && sudo mv %TEMP_ROUTE%/* %FINAL_ROUTE%/"
                    '''
                }
            }
        }

        stage('Fix permissions') {
            steps {
                withCredentials([sshUserPrivateKey(credentialsId: 'ssh-key', keyFileVariable: 'SSH_KEY')]) {
                    bat '''
                        echo Fixing permissions...
                        ssh -o StrictHostKeyChecking=no -i "%SSH_KEY%" %DESTINATION% "sudo chown -R www-data:www-data /var/www/html && sudo chmod -R 755 /var/www/html"
                    '''
                }
            }
        }


        stage('Restart Nginx') {
            steps {
                withCredentials([sshUserPrivateKey(credentialsId: 'ssh-key', keyFileVariable: 'SSH_KEY')]) {
                    bat '''
                        echo Restarting NGINX...
                        ssh -o StrictHostKeyChecking=no -i "%SSH_KEY%" %DESTINATION% "sudo systemctl restart nginx"
                    '''
                }
            }
        }
    }

    post {
        failure {
            echo '❌ Deployment failed.'
        }
        success {
            echo '✅ Deployment successful.'
        }
    }
}

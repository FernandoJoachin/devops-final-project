pipeline {
    agent any

    environment {
        REMOTE_USER = 'ubuntu-server'                    // Usuario SSH
        REMOTE_HOST = '192.168.0.15'                     // IP o nombre de la VM
        REMOTE_PATH = '/var/www/html'                    // Ruta Nginx en la VM
        SSH_KEY = credentials('ssh-key')                 // Credenciales SSH
    }

    stages {
        stage('Obtener build del frontend') {
            steps {
                copyArtifacts(
                    projectName: 'Front Build', // Nombre del job de build
                    filter: 'dist/**',
                    target: 'dist',
                    fingerprintArtifacts: true
                )
            }
        }

        stage('Enviar a la VM') {
            steps {
                bat """
                ssh -i %SSH_KEY% %REMOTE_USER%@%REMOTE_HOST% "sudo rm -rf %REMOTE_PATH%/*"
                scp -i %SSH_KEY% -r dist/* %REMOTE_USER%@%REMOTE_HOST%:%REMOTE_PATH%/
                """
            }
        }

        stage('Reiniciar Nginx (opcional)') {
            steps {
                bat """
                ssh -i %SSH_KEY% %REMOTE_USER%@%REMOTE_HOST% "sudo systemctl restart nginx"
                """
            }
        }
    }
}

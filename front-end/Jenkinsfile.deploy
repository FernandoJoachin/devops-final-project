pipeline {
    agent any

    environment {
        DESTINATION = "ubuntu-server@192.168.0.14"
        REMOTE_IMAGE_PATH = "/home/ubuntu-server/frontend-image.tar"
        IMAGE_NAME = "frontend:latest"
        CONTAINER_NAME = "frontend"
        PORT_MAPPING = "8080:80"
        ENV_CONTENT = 'VITE_API_URL=http://192.168.0.13:3000'
    }

    stages {
        stage('Get frontend Docker image') {
            steps {
                echo "Copying Docker image artifact"
                copyArtifacts(projectName: 'Front Build', selector: lastSuccessful())
                bat 'dir *.tar'
            }
        }

        stage('Deploy Docker container on VM') {
            steps {
                withCredentials([sshUserPrivateKey(credentialsId: 'ssh-key', keyFileVariable: 'SSH_KEY')]) {
                    bat """
                        echo Sending Docker image to VM...
                        scp -o StrictHostKeyChecking=no -i "%SSH_KEY%" frontend-image.tar %DESTINATION%:%REMOTE_IMAGE_PATH%

                        echo Generating .env on remote machine...
                        ssh -o StrictHostKeyChecking=no -i "%SSH_KEY%" %DESTINATION% "echo '%ENV_CONTENT%' > /home/ubuntu-server/.env"

                        echo Deploying container...
                        ssh -o StrictHostKeyChecking=no -i "%SSH_KEY%" %DESTINATION% "docker load -i %REMOTE_IMAGE_PATH% && docker stop %CONTAINER_NAME% || true && docker rm %CONTAINER_NAME% || true && docker run --env-file /home/ubuntu-server/.env -d --name %CONTAINER_NAME% -p %PORT_MAPPING% %IMAGE_NAME%"
                    """
                }
            }
        }
    }

    post {
        failure {
            echo 'Pipeline failed.'
        }
        success {
            echo 'Pipeline successful.'
        }
    }
}

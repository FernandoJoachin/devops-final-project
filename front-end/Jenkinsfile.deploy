pipeline {
    agent any

    environment {
        REMOTE_USER = 'ubuntu-server'
        REMOTE_HOST = '192.168.0.15'
        REMOTE_PATH = '/var/www/html'
    }

    stages {
        stage('Obtener build del frontend') {
            steps {
                copyArtifacts(
                    projectName: 'Front Build',
                    filter: 'dist/**',
                    target: 'dist',
                    fingerprintArtifacts: true
                )
            }
        }

        stage('Enviar a la VM') {
            steps {
                sshagent(['ssh-key']) {
                    bat """
                    ssh %REMOTE_USER%@%REMOTE_HOST% "sudo rm -rf %REMOTE_PATH%/*"
                    scp -r dist/* %REMOTE_USER%@%REMOTE_HOST%:%REMOTE_PATH%/
                    """
                }
            }
        }

        stage('Reiniciar Nginx') {
            steps {
                sshagent(['ssh-key']) {
                    bat """
                    ssh %REMOTE_USER%@%REMOTE_HOST% "sudo systemctl restart nginx"
                    """
                }
            }
        }
    }
}
